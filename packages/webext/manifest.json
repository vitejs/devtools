{
  "action": {
    "default_title": "Vite DevTools",
    "default_popup": "dist/app/popup/popup.html",
    "default_icon": {
      "16": "icons/16-inactive.png",
      "48": "icons/48-inactive.png",
      "128": "icons/128-inactive.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "description": "Chrome Extension for Vite DevTools",
  "devtools_page": "app/background/background.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "manifest_version": 3,
  "name": "Vite DevTools",
  "permissions": [
    "scripting"
  ],
  "version": "0.1.0",
  "version_name": "0.1.0"
}
