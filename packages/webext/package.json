{
  "name": "@vitejs/devtools-webext",
  "type": "module",
  "private": true,
  "description": "DevTools browser extension for Vite (work in progress)",
  "author": "VoidZero Inc.",
  "license": "MIT",
  "homepage": "https://github.com/vitejs/devtools#readme",
  "repository": {
    "directory": "packages/webext",
    "type": "git",
    "url": "git+https://github.com/vitejs/devtools.git"
  },
  "bugs": "https://github.com/vitejs/devtools/issues",
  "keywords": [
    "vite",
    "devtools",
    "chrome extension"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run build:scripts && pnpm run build:client",
    "build:scripts": "tsdown",
    "build:client": "vite build",
    "watch": "turbo watch build --filter=@vitejs/devtools-webext",
    "prepack": "pnpm build",
    "release": "tsx scripts/release.ts",
    "zip": "tsx scripts/zip.ts"
  },
  "dependencies": {
    "devframe": "catalog:deps",
    "webext-bridge": "catalog:deps"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:inlined",
    "@types/archiver": "catalog:types",
    "@types/chrome": "catalog:types",
    "@vitejs/plugin-vue": "catalog:build",
    "archiver": "catalog:build",
    "tsdown": "catalog:build",
    "tsx": "catalog:build",
    "unocss": "catalog:build",
    "vite": "catalog:build",
    "vue": "catalog:deps"
  }
}
